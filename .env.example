# Required to use any AI feature (translation, coaching, transcription).
# Get one from https://vercel.com/docs/ai-gateway, or rely on Vercel OIDC if this
# is deployed inside a Vercel team (no key needed in that case).
AI_GATEWAY_API_KEY=

# Optional: protects the deployed URL with a shared secret. Leave unset for no gate.
# Open the site once with ?k=<value> per device; the browser remembers it after that.
COPILOT_KEY=

# Optional: where scripts/listen.js and scripts/credits.js send requests. Set this to your deployed
# URL once you've run `vercel --prod` (e.g. https://your-project.vercel.app). Leave unset while
# developing locally against `vercel dev` on the default http://localhost:3000.
# COPILOT_URL=https://your-project.vercel.app

# Optional: an access window. Leave both unset for a copilot that never expires.
# COPILOT_ACTIVE_UNTIL=2026-12-01T18:00:00-05:00
# COPILOT_RECALL=enabled

# Optional: a spend guard on your AI Gateway credit. Leave unset (or 0) to disable.
# COPILOT_RESERVE_USD=5
# COPILOT_RESERVE_UNTIL=2026-12-01T00:00:00-05:00

# Optional: pull data/profile.json from a private repo instead of editing it locally.
# MEMORY_REPO=yourname/your-private-config-repo
# MEMORY_PATH=profile.json
